{
  "name": "fpl-workshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,firebase -c cyan,yellow \"vite\" \"node scripts/firebase.mjs emulators:start --only auth,firestore --import=emulator-data --export-on-exit\"",
    "emulators": "node scripts/firebase.mjs emulators:start --only auth,firestore --import=emulator-data --export-on-exit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && node scripts/firebase.mjs deploy --only hosting,firestore:rules",
    "test": "node scripts/firebase.mjs emulators:exec --only firestore \"vitest run\"",
    "test:watch": "node scripts/firebase.mjs emulators:exec --only firestore \"vitest\"",
    "deploy:rules": "node scripts/firebase.mjs deploy --only firestore:rules",
    "seed:gifts": "node scripts/seed-gifts.mjs",
    "seed:gifts:emulator": "node scripts/seed-gifts.mjs --emulator"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
